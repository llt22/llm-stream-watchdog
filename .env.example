# Copy this file to .env and set your OpenAI-compatible upstream.
UPSTREAM_BASE_URL=https://your-provider.example/v1
EVENT_RETENTION_DAYS=30

# Leave empty to keep using credentials supplied by each client.
UPSTREAM_CLAUDE_API_KEYS=
UPSTREAM_OPENAI_API_KEYS=

# Require clients to send this token (Authorization: Bearer <token> or x-api-key).
# Comma-separated for multiple tokens. Leave empty to disable downstream auth.
PROXY_ACCESS_TOKEN=
